{
  "name": "can-solei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm typecheck && next build",
    "start": "next start",
    "lint": "node tooling/lint/node_modules/eslint/bin/eslint.js .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "agenda:update": "node scripts/update-agenda.mjs",
    "preview": "python3 -m http.server 3018 --bind 127.0.0.1 --directory out",
    "images:build": "node scripts/optimize-media.mjs && pnpm images:previews",
    "images:previews": "node scripts/build-media-previews.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@js-temporal/polyfill": "^0.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
